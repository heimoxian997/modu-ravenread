# 复制为 backend/.env 后生效；后端只读取 backend/.env。
# 相对路径以 backend/ 为基准，所以 ../data 指向仓库根目录的 data/。
DATA_DIR=../data
HOST=127.0.0.1
PORT=8000
# 留空时自动使用 <DATA_DIR>/app.db
# DATABASE_URL=sqlite:///<绝对路径>/data/app.db

# ===== 本地嵌入模型（可选，不建索引不需要） =====
EMBEDDING_MODEL=BAAI/bge-m3
# 留空默认 <DATA_DIR>/models/bge-m3；相对路径以 data/ 为基准
EMBEDDING_MODEL_DIR=
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=1024
EMBEDDING_USE_FP16=true
# 留空走 Hugging Face 官方；下载失败时可设置 https://hf-mirror.com
HF_ENDPOINT=

# ===== 本地 Qdrant 文本向量层 =====
# 留空默认 <DATA_DIR>/qdrant；相对路径以 data/ 为基准
QDRANT_PATH=
TEXT_INDEX_COLLECTION=novel_text
TEXT_INDEX_VERSION=1
